{
  "id": "check-treasury-position",
  "schema": "arcis-skill/1.0",
  "name": "Check Treasury Position",
  "summary": "Read an agent's vault position, current value, and the live vault APY.",
  "category": "read",
  "when_to_use": "The agent or its operator wants to know how much is deposited and what it's earning. Read-only, no signing.",
  "inputs": [
    {
      "name": "agent",
      "type": "address",
      "description": "The agent wallet address to check"
    }
  ],
  "outputs": [
    {
      "name": "shares",
      "type": "uint256",
      "description": "raUSDC share balance"
    },
    {
      "name": "value",
      "type": "uint256",
      "description": "USDC value of the position"
    },
    {
      "name": "apy",
      "type": "string",
      "description": "Current vault APY"
    }
  ],
  "invocation": {
    "mcp": {
      "server": "https://mcp.arcis.money/mcp",
      "hint": "Ask: 'check the Arcis position for <address>'"
    },
    "sdk": {
      "package": "@arcisprotocol/sdk",
      "code": "const pos = await vault.position(agent);\nconst apy = await vault.apy();"
    },
    "cli": {
      "package": "@arcisprotocol/cli",
      "command": "arcis vault balance <address>"
    },
    "rest": {
      "url": "https://mcp.arcis.money/api/vault",
      "hint": "GET for global vault state incl. apy"
    }
  },
  "protocol": "Agent Treasury Interface (ATI)",
  "network": {
    "name": "Base",
    "chainId": 8453
  },
  "publisher": "Arcis Protocol",
  "contracts": {
    "vault": "0x00325d9da832b38179ed2f0dabd4062d93e325a7",
    "factory": "0x9f5697eEB94ee1C7CEDfEb2080A9398D42170FBC",
    "credit": "0xdf31800e620f728297340d66acf5a306f07ce7a1",
    "usdc": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
  },
  "docs": "https://github.com/Arcis-Protocol/docs/blob/main/INTEGRATION.md"
}